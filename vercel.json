{
  "buildCommand": "node scripts/build-static.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "^/$",              "dest": "/index.html" },
    { "src": "^/services$",      "dest": "/services.html" },
    { "src": "^/booking-guide$", "dest": "/booking-guide.html" },
    { "src": "^/privacy$",       "dest": "/privacy.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)",            "dest": "/404.html", "status": 404 }
  ]
}
